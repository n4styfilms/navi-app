{
  "rules": {
    ".read": false,
    ".write": false,
    "friendConsent": {
      "$owner": {
        ".read": "auth != null && auth.uid === $owner",
        "$peer": {
          ".read": "auth != null && (auth.uid === $owner || auth.uid === $peer)",
          ".write": "(auth != null && auth.uid === $owner) && $owner !== $peer",
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "grants": {
      "$owner": {
        ".read": "auth != null && auth.uid === $owner",
        "$viewer": {
          ".read": "auth != null && (auth.uid === $owner || auth.uid === $viewer)",
          ".write": "(auth != null && auth.uid === $owner) && $owner !== $viewer",
          ".validate": "newData.hasChildren([\"position\", \"speed\", \"trips\"])",
          "position": {
            ".validate": "newData.isBoolean()"
          },
          "speed": {
            ".validate": "newData.isBoolean()"
          },
          "trips": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "requests": {
      "$recipient": {
        ".read": "auth != null && auth.uid === $recipient",
        "$sender": {
          ".read": "auth != null && (auth.uid === $recipient || auth.uid === $sender)",
          ".write": "auth != null && $recipient !== $sender && (auth.uid === $sender || (auth.uid === $recipient && !newData.exists()))",
          ".validate": "newData.hasChildren([\"createdAtMs\"])",
          "createdAtMs": {
            ".validate": "newData.isNumber() && newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "profiles": {
      "$owner": {
        ".read": "(auth != null && auth.uid === $owner) || (auth != null && (root.child('friendConsent').child($owner).child(auth.uid).val() === true && root.child('friendConsent').child(auth.uid).child($owner).val() === true))",
        ".write": "auth != null && auth.uid === $owner",
        ".validate": "newData.hasChildren([\"displayName\"])",
        "displayName": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "live": {
      "$owner": {
        "position": {
          ".validate": "newData.hasChildren([\"sequence\", \"latitude\", \"longitude\", \"accuracyMeters\", \"measuredAtMs\", \"receivedAtMs\"]) && (!data.exists() || newData.child('sequence').val() > data.child('sequence').val())",
          "sequence": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 9007199254740991 && newData.val() % 1 === 0"
          },
          "latitude": {
            ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
          },
          "longitude": {
            ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
          },
          "accuracyMeters": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "measuredAtMs": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= now + 60000"
          },
          "receivedAtMs": {
            ".validate": "newData.isNumber() && newData.val() === now"
          },
          "bearingDegrees": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 360"
          },
          "$other": {
            ".validate": false
          },
          ".read": "(auth != null && auth.uid === $owner) || (auth != null && (root.child('friendConsent').child($owner).child(auth.uid).val() === true && root.child('friendConsent').child(auth.uid).child($owner).val() === true) && root.child('grants').child($owner).child(auth.uid).child('position').val() === true)",
          ".write": "auth != null && auth.uid === $owner"
        },
        "speed": {
          ".validate": "newData.hasChildren([\"sequence\", \"measuredAtMs\"]) && newData.child('sequence').val() === newData.parent().child('position').child('sequence').val()",
          "sequence": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 9007199254740991 && newData.val() % 1 === 0"
          },
          "measuredAtMs": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= now + 60000"
          },
          "metersPerSecond": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "$other": {
            ".validate": false
          },
          ".read": "((auth != null && auth.uid === $owner) || ((auth != null && (root.child('friendConsent').child($owner).child(auth.uid).val() === true && root.child('friendConsent').child(auth.uid).child($owner).val() === true) && root.child('grants').child($owner).child(auth.uid).child('position').val() === true) && (auth != null && (root.child('friendConsent').child($owner).child(auth.uid).val() === true && root.child('friendConsent').child(auth.uid).child($owner).val() === true) && root.child('grants').child($owner).child(auth.uid).child('speed').val() === true))) && data.child('sequence').val() === root.child('live').child($owner).child('position').child('sequence').val()",
          ".write": "auth != null && auth.uid === $owner"
        }
      }
    },
    "tripIndex": {
      "$owner": {
        ".indexOn": [
          "endedAtMs"
        ],
        ".read": "((auth != null && auth.uid === $owner) || (auth != null && (root.child('friendConsent').child($owner).child(auth.uid).val() === true && root.child('friendConsent').child(auth.uid).child($owner).val() === true) && root.child('grants').child($owner).child(auth.uid).child('trips').val() === true)) && query.orderByChild === \"endedAtMs\" && query.startAt >= now - 2592000000",
        "$tripId": {
          ".validate": "newData.hasChildren([\"startedAtMs\", \"endedAtMs\", \"distanceMeters\", \"durationSeconds\"]) && $tripId.matches(/^[a-zA-Z0-9_-]{1,64}$/) && newData.child('endedAtMs').val() >= newData.child('startedAtMs').val() && newData.child('endedAtMs').val() >= now - 2592000000",
          "startedAtMs": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= now + 60000"
          },
          "endedAtMs": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= now + 60000"
          },
          "distanceMeters": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "durationSeconds": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "$other": {
            ".validate": false
          },
          ".read": "((auth != null && auth.uid === $owner) || (auth != null && (root.child('friendConsent').child($owner).child(auth.uid).val() === true && root.child('friendConsent').child(auth.uid).child($owner).val() === true) && root.child('grants').child($owner).child(auth.uid).child('trips').val() === true)) && (data.child('endedAtMs').isNumber() && data.child('endedAtMs').val() >= now - 2592000000 && data.child('endedAtMs').val() <= now + 60000)",
          ".write": "auth != null && auth.uid === $owner"
        }
      }
    },
    "tripChunks": {
      "$owner": {
        "$tripId": {
          ".read": "((auth != null && auth.uid === $owner) || (auth != null && (root.child('friendConsent').child($owner).child(auth.uid).val() === true && root.child('friendConsent').child(auth.uid).child($owner).val() === true) && root.child('grants').child($owner).child(auth.uid).child('trips').val() === true)) && root.child('tripIndex').child($owner).child($tripId).child('endedAtMs').isNumber() && root.child('tripIndex').child($owner).child($tripId).child('endedAtMs').val() >= now - 2592000000 && root.child('tripIndex').child($owner).child($tripId).child('endedAtMs').val() <= now + 60000",
          "$chunk": {
            ".validate": "newData.hasChildren([\"createdAtMs\", \"points\"]) && $chunk.matches(/^(0|[1-9][0-9]{0,2})$/)",
            "createdAtMs": {
              ".validate": "newData.isNumber() && newData.val() === now"
            },
            "points": {
              ".validate": "newData.hasChildren()",
              "$point": {
                ".validate": "newData.hasChildren([\"latitude\", \"longitude\", \"accuracyMeters\", \"measuredAtMs\"]) && $point.matches(/^(0|[1-9][0-9]?)$/) && newData.child('measuredAtMs').val() >= root.child('tripIndex').child($owner).child($tripId).child('startedAtMs').val() && newData.child('measuredAtMs').val() <= root.child('tripIndex').child($owner).child($tripId).child('endedAtMs').val()",
                "latitude": {
                  ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
                },
                "longitude": {
                  ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
                },
                "accuracyMeters": {
                  ".validate": "newData.isNumber() && newData.val() >= 0"
                },
                "measuredAtMs": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= now + 60000"
                },
                "metersPerSecond": {
                  ".validate": "newData.isNumber() && newData.val() >= 0"
                },
                "bearingDegrees": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 360"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "$other": {
              ".validate": false
            },
            ".write": "(auth != null && auth.uid === $owner) && (!newData.exists() || root.child('tripIndex').child($owner).child($tripId).exists())"
          }
        }
      }
    }
  }
}
